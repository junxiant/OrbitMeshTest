# Provided by the interview organizer. Never commit a real key.
OPENROUTER_API_KEY=

# OpenRouter API endpoint (OpenAI-compatible).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local vector database from docker-compose.yml, if you use it.
QDRANT_URL=http://localhost:6333
# Blank for embedded
# QDRANT_URL=
# QDRANT_PATH=data/qdrant

# Use openrouter or mock
LLM_MODE=mock
# Try to use free
OPENROUTER_MODEL=
# Seconds
LLM_RATE_LIMIT_DELAY=1.5

# Backend API Authentication
API_KEY=orbitmesh-secret-key

# Database configuration (PostgreSQL)
DB_BACKEND=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
